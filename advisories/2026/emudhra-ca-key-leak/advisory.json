  "remediation": {
    "summary": "Remove the anchor roots from every trust store you control, or add explicit distrust for the compromised intermediates where the store supports it. Then re-run the check.",
    "steps_file": "fix.md"
  },
  "check": {
    "requires": {
      "read_paths": [
        "trust stores discovered by the inventory"
      ],
      "binaries": {
        "optional": [
          "keytool",
          "node"
        ]
      },
      "network": [],
      "scratch": false,
      "timeout_seconds": 60
    },
    "limitations": [
      "Stores with a distrust mechanism (NSS, Windows, macOS keychain) are reported as unknown in v0.",
      "A store that trusts an anchor is reported affected even if the client using it performs CRL or OCSP checks; most do not.",
      "Compromised intermediates are matched by certificate SHA-256 only in v0; SKI matching is listed for future store parsers that expose it."
    ]
  },
